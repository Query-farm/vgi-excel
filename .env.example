# Browser runtime error reporting. Packaged production builds use the checked-in
# project DSNs unless overridden; Vite development servers stay off by default.
VITE_SENTRY_ENABLED=1
VITE_SENTRY_ENABLE_LOCAL=0
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_OFFICE_DSN=
VITE_SENTRY_DESKTOP_DSN=

# Build-time source-map upload. Keep SENTRY_AUTH_TOKEN in CI secrets only.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
SENTRY_OFFICE_PROJECT=cupola-excel-office
SENTRY_DESKTOP_PROJECT=cupola-excel-desktop

# Native XLL overrides are process-level Windows environment variables.
VGI_EXCEL_TELEMETRY=1
VGI_EXCEL_SENTRY_ENVIRONMENT=production
VGI_EXCEL_SENTRY_DSN=
